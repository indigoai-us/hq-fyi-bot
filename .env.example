# Required for `npm start` and `npm run backfill`.
X_BEARER_TOKEN=x_bearer_token_here

# Required unless SLACK_DRY_RUN=1.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Bot behavior.
HQ_X_TARGET_HANDLE=hq_fyi
HQ_X_ALLOWED_AUTHORS=example_author
HQ_X_RULE_VALUE='@hq_fyi -is:retweet'
SLACK_CHANNEL_NAME=hq-fyi
SLACK_DRY_RUN=1

# Local state. Keep these paths persistent in production.
DEDUPE_STORE_PATH=.data/processed-mentions.json
DEAD_LETTER_PATH=.data/dead-letter.jsonl
HEALTH_STATE_PATH=.data/health.json

# Retry tuning.
RETRY_ATTEMPTS=3
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
